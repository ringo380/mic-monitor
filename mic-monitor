#!/bin/zsh
# Toggle live Yeti -> Corsair headphone monitoring.
# Usage: mic-monitor [start|stop|status|toggle]   (default: toggle)
PY=/opt/homebrew/bin/python3
# Resolve our own real path (follows the ~/.local/bin symlink) so the worker
# script is always found next to this wrapper in the repo.
SELF="${0:A}"
SCRIPT="${SELF:h}/yeti-monitor.py"
PIDFILE="${TMPDIR:-/tmp}/mic-monitor.pid"
LOG="${TMPDIR:-/tmp}/mic-monitor.log"

is_running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null }

start() {
  if is_running; then echo "Already running (pid $(cat "$PIDFILE"))."; return; fi
  nohup "$PY" "$SCRIPT" "$@" >"$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  echo "Started mic monitor (pid $!). Log: $LOG"
}

stop() {
  if is_running; then
    kill -TERM "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "Stopped."
  else
    echo "Not running."
    rm -f "$PIDFILE"
  fi
}

case "${1:-toggle}" in
  start)  shift; start "$@" ;;
  stop)   stop ;;
  status) is_running && echo "Running (pid $(cat "$PIDFILE"))." || echo "Not running." ;;
  toggle) is_running && stop || start ;;
  *) echo "Usage: mic-monitor [start|stop|status|toggle]"; exit 1 ;;
esac
